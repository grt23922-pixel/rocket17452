                drag=true; dragStart=input.Position; startPos=mf.Position
                input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then drag=false end end)
            end
        end)
        mf.InputChanged:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseMovement then dragInput=input end end)
        UserInputService.InputChanged:Connect(function(input)
            if input == dragInput and drag then
                local delta = input.Position - dragStart
                mf.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset+delta.X, startPos.Y.Scale, startPos.Y.Offset+delta.Y)
            end
        end)
        
        return sg
    end
    
    task.wait(0.3)
    harpoon = getHarpoon()
    if harpoon then print("HARPOON READY") else print("HARPOON NOT FOUND") end
    
    local gui = createGUI()
    
    RunService.Heartbeat:Connect(function()
        if farmEnabled and char and char.Parent and hum and hum.Health > 0 then
            root = char:FindFirstChild("HumanoidRootPart") or root
            local res = findRes()
            if #res > 0 and canAttack then attack(res[1]) end
        end
        if flying then updateFly() end
    end)
    
    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        
        if input.KeyCode == Enum.KeyCode.F then
            toggleFly()
            for _,c in pairs(Player.PlayerGui:GetDescendants()) do
                if c:IsA("TextButton") and c.Text and c.Text:find("FLY") then
                    c.Text = flying and "FLY OFF" or "FLY ON"
                    c.BackgroundColor3 = flying and Color3.fromRGB(200,50,50) or Color3.fromRGB(50,150,50)
                end
            end
        end
        
        if input.KeyCode == Enum.KeyCode.R then
            flySpeed = 50
            for _,c in pairs(Player.PlayerGui:GetDescendants()) do
                if c:IsA("TextLabel") and c.Text and tonumber(c.Text) then c.Text = tostring(flySpeed) end
            end
        end
        
        if input.KeyCode == Enum.KeyCode.F1 then
            farmEnabled = not farmEnabled
            for _,c in pairs(Player.PlayerGui:GetDescendants()) do
                if c:IsA("TextButton") and c.Name == "FarmBtn" then
                    if farmEnabled then c.BackgroundColor3=Color3.fromRGB(50,200,50); c.Text="FARM ON"
                    else c.BackgroundColor3=Color3.fromRGB(200,50,50); c.Text="FARM OFF" end
                end
                if c:IsA("TextLabel") and c.Text and (c.Text:find("ON") or c.Text:find("OFF")) then
                    if farmEnabled then c.Text="ON"; c.TextColor3=Color3.fromRGB(0,255,0)
                    else c.Text="OFF"; c.TextColor3=Color3.fromRGB(255,0,0) end
                end
            end
        end
        
        if input.KeyCode == Enum.KeyCode.F2 then
            harpoon = getHarpoon()
            print(harpoon and "HARPOON READY" or "HARPOON NOT FOUND")
        end
        
        if input.KeyCode == Enum.KeyCode.F3 then
            local res = findRes()
            if #res > 0 then attack(res[1]) end
        end
        
        if input.KeyCode == Enum.KeyCode.F4 then
            local res = findRes()
            if #res > 0 then teleport(res[1]) end
        end
    end)
    
    Player.CharacterAdded:Connect(function(newChar)
        char = newChar; task.wait(0.5)
        root = char:WaitForChild("HumanoidRootPart")
        hum = char:WaitForChild("Humanoid")
        harpoon = nil
        if flying then
            if bv then bv:Destroy(); bv=nil end
            if bg then bg:Destroy(); bg=nil end
            flying=false; hum.PlatformStand=false; hum.AutoRotate=true
        end
    end)
    
    print("")
    print("=========================================")
    print("   ROCKET ULTIMATE v10.6")
    print("=========================================")
    print("")
    print("CONTROLS:")
    print("  F1 - Farm ON/OFF")
    print("  F2 - Get Harpoon")
    print("  F3 - Manual Attack")
    print("  F4 - Teleport")
    print("  F  - Fly ON/OFF")
    print("  R  - Reset Speed")
    print("  WASD - Move")
    print("  E - Up | Q - Down")
    print("")
    print("=========================================")
    print("READY!")
    print("=========================================")
end

showLockScreen()
