function startRocket()
    local farmEnabled = false
    local canAttack = true
    local harpoon = nil
    local flying = false
    local flySpeed = 50
    local bv = nil
    local bg = nil
    local mouseOverGUI = false
    
    local char = Player.Character or Player.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart")
    local hum = char:WaitForChild("Humanoid")
    
    local function getHarpoon()
        for _,c in pairs(char:GetChildren()) do
            if c:IsA("Tool") then
                local n = c.Name:lower()
                if n:find("harpoon") or n:find("hook") or n:find("гарпун") or n:find("spear") then
                    return c
                end
            end
        end
        local s = Player.Backpack:FindFirstChild("Slot3")
        if s then for _,t in pairs(s:GetChildren()) do if t:IsA("Tool") then t.Parent=char; wait(0.1); return t end end end
        for _,t in pairs(Player.Backpack:GetChildren()) do if t:IsA("Tool") then t.Parent=char; wait(0.1); return t end end
        return nil
    end
    
    local function findRes()
        local res = {}
        for _,o in pairs(Workspace:GetDescendants()) do
            if o:IsA("BasePart") and o.Anchored then
                local n = o.Name:lower()
                local p = o.Parent and o.Parent.Name:lower() or ""
                local isR = false
                local kw = {"wood","stone","metal","iron","gold","crystal","ore","plank","rock","copper","coal","diamond","gem","resource","log","tree","barrel","crate","box","loot","ресурс","руда"}
                for _,k in pairs(kw) do if n:find(k) or p:find(k) then isR=true break end end
                if not isR and o:FindFirstChild("Highlight") then isR=true end
                if isR then
                    local d = (o.Position - root.Position).Magnitude
                    if d <= 500 then table.insert(res, {part=o,pos=o.Position,dist=d}) end
                end
            end
        end
        table.sort(res, function(a,b) return a.dist < b.dist end)
        return res
    end
    
    local function teleport(r)
        if not r then return end
        local np = Vector3.new(r.pos.X, r.pos.Y+2, r.pos.Z)
        pcall(function() root.CFrame = CFrame.new(np); root.Velocity = Vector3.new(0,0,0); char:MoveTo(np) end)
    end
    
    local function attack(r)
        if not r or not canAttack or not farmEnabled or mouseOverGUI then return end
        if not harpoon or harpoon.Parent ~= char then harpoon = getHarpoon(); if not harpoon then return end end
        teleport(r); wait(0.05)
        pcall(function() Mouse.Target = r.part; Mouse.Button1Down:Fire(); wait(0.05); Mouse.Button1Up:Fire() end)
        pcall(function() VirtualInputManager:SendMouseButtonEvent(0,0,0,true,game,0); wait(0.05); VirtualInputManager:SendMouseButtonEvent(0,0,0,false,game,0) end)
        canAttack = false; task.wait(0.15); canAttack = true
    end
    
    local function toggleFly()
        if flying then
            if bv then bv:Destroy(); bv=nil end
            if bg then bg:Destroy(); bg=nil end
            flying=false; hum.PlatformStand=false; hum.AutoRotate=true; print("FLY OFF")
        else
            bv = Instance.new("BodyVelocity"); bv.MaxForce = Vector3.new(4000,4000,4000); bv.Velocity = Vector3.new(0,0,0); bv.Parent = root
            bg = Instance.new("BodyGyro"); bg.MaxTorque = Vector3.new(4000,4000,4000); bg.Parent = root
            flying=true; hum.PlatformStand=true; hum.AutoRotate=false; print("FLY ON")
        end
    end
    
    local function updateFly()
        if not flying or not bv then return end
        local cam = workspace.CurrentCamera
        local v = Vector3.new(0,0,0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then v = v + (cam.CFrame.LookVector * flySpeed) end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then v = v - (cam.CFrame.LookVector * flySpeed) end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then v = v - (cam.CFrame.RightVector * flySpeed) end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then v = v + (cam.CFrame.RightVector * flySpeed) end
        if UserInputService:IsKeyDown(Enum.KeyCode.E) then v = v + (Vector3.new(0, flySpeed, 0)) end
        if UserInputService:IsKeyDown(Enum.KeyCode.Q) then v = v - (Vector3.new(0, flySpeed, 0)) end
        bv.Velocity = v
        if v.Magnitude > 0.1 then bg.CFrame = CFrame.lookAt(root.Position, root.Position+v, Vector3.new(0,1,0)) end
    end
    
