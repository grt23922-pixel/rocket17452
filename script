local function copyToClipboard(text)
    -- МЕТОД 1: setclipboard (для Xeno Executor)
    pcall(function()
        setclipboard(text)
        print("Copied via setclipboard: " .. text)
        return true
    end)
    
    -- МЕТОД 2: ClipboardService
    pcall(function()
        game:GetService("ClipboardService"):Set(text)
        print("Copied via ClipboardService: " .. text)
        return true
    end)
    
    -- МЕТОД 3: toclipboard
    pcall(function()
        toclipboard(text)
        print("Copied via toclipboard: " .. text)
        return true
    end)
    
    -- МЕТОД 4: Через VirtualInputManager (Ctrl+C)
    pcall(function()
        local frame = Instance.new("Frame")
        frame.Parent = Player.PlayerGui
        frame.Size = UDim2.new(0, 0, 0, 0)
        frame.Position = UDim2.new(0, 0, 0, 0)
        frame.BackgroundTransparency = 1
        
        local textBox = Instance.new("TextBox")
        textBox.Parent = frame
        textBox.Size = UDim2.new(0, 400, 0, 30)
        textBox.Position = UDim2.new(0.5, -200, 0.5, -15)
        textBox.Text = text
        textBox.Visible = false
        textBox:CaptureFocus()
        
        VirtualInputManager:SendKeyEvent(true, "A", false, game)
        wait(0.05)
        VirtualInputManager:SendKeyEvent(false, "A", false, game)
        wait(0.05)
        VirtualInputManager:SendKeyEvent(true, "C", true, game)
        wait(0.05)
        VirtualInputManager:SendKeyEvent(false, "C", true, game)
        
        textBox.Visible = false
        frame:Destroy()
        print("Copied via VirtualInputManager: " .. text)
        return true
    end)
    
    -- МЕТОД 5: Через синхронный клипборд (если доступен)
    pcall(function()
        if syn and syn.clipboard then
            syn.clipboard(text)
            print("Copied via syn.clipboard: " .. text)
            return true
        end
    end)
end

